{
  "name": "dsh-local-llm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Detect, probe and register local OpenAI-compatible LLM servers (LM Studio, Ollama, vLLM, llama.cpp) as DeepSeek Harness model providers.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm",
    "local-llm",
    "ollama",
    "lmstudio",
    "vllm",
    "llama.cpp",
    "openai-compatible",
    "model-provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philo-max/dsh-local-llm.git"
  },
  "homepage": "https://github.com/philo-max/dsh-local-llm#readme",
  "bugs": {
    "url": "https://github.com/philo-max/dsh-local-llm/issues"
  },
  "author": "philo-max",
  "license": "MIT"
}
